  "narracion": [
   {
    "texto": "Bansir fabricaba carros en Babilonia. Trabajaba todo el día, y nunca le alcanzaba.",
    "estilo": "narrador"
   },
   {
    "texto": "Un día fue a ver a Arkad, el hombre más rico de la ciudad, que había empezado igual de pobre.",
